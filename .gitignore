# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# VitePress docs site (docs/ — the committed docs, not the ignored @docs)
docs/.vitepress/dist/
docs/.vitepress/cache/

# Yerd GUI (apps/yerd-gui — Tauri v2 + Vue frontend)
node_modules/
# Node 24 bytecode cache (NODE_COMPILE_CACHE), regenerated on every run
node-compile-cache/
apps/yerd-gui/dist/
# Vite dependency pre-bundle cache (regenerated on dev/build)
apps/yerd-gui/.vite/
# Tauri-generated schemas/permissions (regenerated by the build)
apps/yerd-gui/src-tauri/gen/
# CI-staged macOS daemon sidecar (built per-release; never committed). The
# release build copies `yerdd` here as `yerdd-aarch64-apple-darwin` for
# bundle.externalBin (see tauri.bundle-macos.conf.json + release.yml).
apps/yerd-gui/src-tauri/binaries/

# macOS
.DS_Store

# General
# Yerd ignored .claude entirely. Orcker versions the agentic harness (SDD section
# 3): settings, subagents and slash commands are the process, not local config.
# Only the personal override stays out.
.claude/settings.local.json
@docs
.agents
.openai
